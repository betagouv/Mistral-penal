{% extends 'base.html.twig' %}

{% block title %}{{'compte.index.title'|trans}}{% endblock %}

{% block javascripts %}
  {{parent()}}
{% endblock %}

{% block body %}
<div class="fr-grid-row">
    <div class="fr-col-12 audience-bandeau fr-p-2w">
        <div class="fr-grid-row">
            <div class="fr-col-1 fr-pl-3w">
                <img
                src="{{ asset('build/images/avatar.svg') }}"
                alt="avatar"
                height="60px"
                width="60px"
                />
            </div>
            <div class="fr-col-9 fr-mt-2w">
                <h2>{{'compte.index.title'|trans}}</h2>
            </div>
            <div class="fr-col-2 fr-mt-1w">
                <a href="{{path('logout')}}" class="fr-btn"><i class="ri-logout-box-r-line fr-pr-1w"></i>
                {{'compte.btn.logout'|trans}}</a>
            </div>
        </div>
    </div>
    <div class="fr-col-12 fr-mt-4w"></div>
</div>
<div class="fr-grid-row fr-px-3w" >
    <div class="fr-col-12 compte-informations">
        <div class="fr-grid-row">
            <div class="fr-col-2 compte-informations-title fr-ml-5w">Informations</div>
        </div>
    </div>
    <div class="fr-col-12 fr-mt-5w"></div>
    <div class="fr-col-12 compte-informations-text fr-pl-3w">
        <strong>{{'compte.index.utilisateur'|trans}}</strong>: {{account.username}}
    </div>
    <div class="fr-col-12 compte-informations-text fr-pl-3w fr-pt-1v">
        <strong>{{'compte.field.roles'|trans}}</strong>: {{account.rolesPlaintext}}
    </div>
    <div class="fr-col-12 compte-informations-text fr-pl-3w fr-pt-1v">
        <strong>Version courante :</strong>
        <table class="fr-table" border="1">
          <tr>
            <th>Date</th>
            <th>Utilisateur</th>
            <th>Message technique</th>
          </tr>
          {% for log in logs %}
          <tr>
            <td>{{log.date}}</td>
            <td>{{log.user}}</td>
            <td>{{log.action}}</td>
          </tr>
          {% endfor %}
        </table>
    </div>

    <div class="fr-col-12 fr-mt-5w"></div>
    <div class="fr-col-12">
        <div class="importation-ksp">
            <i id="icon-info" class="info-blue-icon">&emsp;&nbsp;</i>&ensp;
            <span id="importation-message" class="importation-message">
                Vous êtes connecté grâce à vos identifiants Cassiopée. Consultez-le pour visualiser ou éditer vos identifiants.
            </span>
        </div>
    </div>
    <div class="fr-col-12 compte-footer"></div>
</div>


    {# <div class="fr-col-12 fr-table">
      <table>
        <caption>{{'compte.field.services'|trans}}</caption>
        <thead>
